# Supabase environment variables
# Copy this file to .env.local and fill in your actual credentials

# Supabase API URL (from Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (from Project Settings > API > anon, public)
# Safe to use in frontend code; restricted by RLS policies
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (DO NOT expose in frontend)
# Only use in backend/trusted environments for admin operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment Type (development, production)
APP_ENV=development
